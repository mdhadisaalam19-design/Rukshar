    </button>

    <!-- RIBBON -->
    <div class="ribbon-area">

        <h2 style="margin-top:35px;">
            🎀 GRAND OPENING RIBBON CUTTING 🎀
        </h2>

        <div class="ribbon" id="ribbon"></div>

        <div class="scissors" onclick="cutRibbon()">
            ✂️
        </div>

        <button class="celebrate-btn" onclick="celebrate()">
            🎉 CELEBRATE!
        </button>

    </div>

</section>


<!-- MENU -->
<section class="menu-section">

<h2>🍽️ MIR CAFE SPECIAL MENU</h2>

<div class="menu">

    <div class="card">
        <div class="food-icon">☕</div>
        <h3>Coffee</h3>
        <p class="old-price">Rs. 150</p>
        <p class="new-price">Rs. 45</p>
        <span class="discount">70% OFF</span>
    </div>

    <div class="card">
        <div class="food-icon">🍵</div>
        <h3>Tea</h3>
        <p class="old-price">Rs. 100</p>
        <p class="new-price">Rs. 30</p>
        <span class="discount">70% OFF</span>
    </div>

    <div class="card">
        <div class="food-icon">🥙</div>
        <h3>Saurma</h3>
        <p class="old-price">Rs. 250</p>
        <p class="new-price">Rs. 75</p>
        <span class="discount">70% OFF</span>
    </div>

    <div class="card">
        <div class="food-icon">🥤</div>
        <h3>Cold Coffee</h3>
        <p class="old-price">Rs. 220</p>
        <p class="new-price">Rs. 66</p>
        <span class="discount">70% OFF</span>
    </div>

    <div class="card">
        <div class="food-icon">🍜</div>
        <h3>Chaumin</h3>
        <p class="old-price">Rs. 200</p>
        <p class="new-price">Rs. 60</p>
        <span class="discount">70% OFF</span>
    </div>

    <div class="card">
        <div class="food-icon">🥟</div>
        <h3>Momo</h3>
        <p class="old-price">Rs. 180</p>
        <p class="new-price">Rs. 54</p>
        <span class="discount">70% OFF</span>
    </div>

    <div class="card">
        <div class="food-icon">🥟</div>
        <h3>Buff Momo</h3>
        <p class="old-price">Rs. 220</p>
        <p class="new-price">Rs. 66</p>
        <span class="discount">70% OFF</span>
    </div>

    <div class="card">
        <div class="food-icon">🍕</div>
        <h3>Pizza</h3>
        <p class="old-price">Rs. 400</p>
