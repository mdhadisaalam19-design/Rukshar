        <span class="discount">70% OFF</span>
    </div>

</div>

</section>


<footer>
    <h2>❤️ Welcome to MIR CAFE ❤️</h2>
    <p>Grand Opening: <strong>September 25, 2026</strong></p>
    <p>🎉 70% OFF ON EVERY ITEM 🎉</p>
</footer>


<script>

/* OPEN DOOR */
function openDoor() {
    document.getElementById("door").classList.add("open");

    createHearts();
    createConfetti();
}


/* CUT RIBBON */
function cutRibbon() {

    const ribbon = document.getElementById("ribbon");

    ribbon.classList.add("cut");

    createHearts();
    createConfetti();

    setTimeout(() => {
        alert("🎉 Congratulations! MIR CAFE is officially OPEN! 🎉");
    }, 500);
}


/* CELEBRATION */
function celebrate() {

    createHearts();
    createConfetti();

    alert(
        "🎉🎉 WELCOME TO MIR CAFE! 🎉🎉\n\n" +
        "Grand Opening: September 25, 2026\n" +
        "🔥 70% OFF EVERY ITEM 🔥"
    );
}


/* FLOATING HEARTS */
function createHearts() {

    for(let i = 0; i < 20; i++) {

        const heart = document.createElement("div");

        heart.className = "heart";

        heart.innerHTML = Math.random() > 0.5 ? "❤️" : "💖";

        heart.style.left = Math.random() * 100 + "%";

        heart.style.animationDuration =
            (3 + Math.random() * 4) + "s";

        document.body.appendChild(heart);

        setTimeout(() => {
            heart.remove();
        }, 7000);
    }
}


/* CONFETTI */
function createConfetti() {

    const symbols = ["🎉", "✨", "🎊", "❤️", "⭐"];

    for(let i = 0; i < 35; i++) {

        const confetti = document.createElement("div");

        confetti.innerHTML =
            symbols[Math.floor(Math.random() * symbols.length)];

        confetti.style.position = "fixed";
        confetti.style.left = Math.random() * 100 + "%";
        confetti.style.top = "-30px";
        confetti.style.fontSize =
            (15 + Math.random() * 20) + "px";
        confetti.style.zIndex = "9999";
        confetti.style.pointerEvents = "none";

        document.body.appendChild(confetti);

        const animation = confetti.animate(
            [
                {
                    transform: "translateY(0) rotate(0deg)",
                    opacity: 1
                },
                {
                    transform:
                        "translateY(110vh) rotate(720deg)",
                    opacity: 0
                }
            ],
            {
                duration: 2500 + Math.random() * 2500,
                easing: "ease-out"
            }
        );

        animation.onfinish = () => confetti.remove();
    }
}

</script>

</body>
</html>
